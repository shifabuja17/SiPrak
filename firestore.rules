rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helper Autentikasi & Role ----------
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userDoc(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function hasUserDoc() {
      return signedIn() && exists(userDoc(request.auth.uid));
    }

    function userRole() {
      return get(userDoc(request.auth.uid)).data.role;
    }

    function isAslabRole(role) {
      return role in ['ASLAB', 'aslab'];
    }

    function isAsprakRole(role) {
      return role in ['ASPRAK', 'asprak', 'ASISTEN', 'asisten'];
    }

    function isPraktikanRole(role) {
      return role in ['PRAKTIKAN', 'praktikan'];
    }

    function isSameNormalizedRole(a, b) {
      return (isAslabRole(a) && isAslabRole(b))
        || (isAsprakRole(a) && isAsprakRole(b))
        || (isPraktikanRole(a) && isPraktikanRole(b));
    }

    function isAslab() {
      return hasUserDoc() && isAslabRole(userRole());
    }

    function isAsprak() {
      return hasUserDoc() && isAsprakRole(userRole());
    }

    function isPraktikan() {
      return hasUserDoc() && isPraktikanRole(userRole());
    }

    function isAsisten() {
      return isAslab() || isAsprak();
    }

    // ---------- Helper Keanggotaan Lab ----------
    function labMemberPath(labId, uid) {
      return /databases/$(database)/documents/labMembers/$(labId + '_' + uid);
    }

    function isAsprakOfLab(labId) {
      return isAsprak()
        && labId is string
        && labId.size() > 0
        && exists(labMemberPath(labId, request.auth.uid))
        && get(labMemberPath(labId, request.auth.uid)).data.aktif == true
        && get(labMemberPath(labId, request.auth.uid)).data.peran == 'asprak';
    }

    // ---------- Helper Dokumen & Lokasi ----------
    function validStatusSesi() {
      return request.resource.data.status in ['dijadwalkan', 'dibuka', 'ditutup'];
    }

    function sessionDoc(sessionId) {
      return get(/databases/$(database)/documents/sessions/$(sessionId)).data;
    }

    function labDoc(labId) {
      return get(/databases/$(database)/documents/laboratories/$(labId)).data;
    }

    function leaveRequestLabId(data) {
      return data.get('labId', sessionDoc(data.sessionId).get('labId', ''));
    }

    function isRecordOwner(data) {
      return signedIn()
        && (data.get('userId', '') == request.auth.uid
            || data.get('uid', '') == request.auth.uid
            || data.get('praktikanId', '') == request.auth.uid);
    }

    // Pemeriksaan radius di server (Sprint 3 NFR-01). Rules tidak punya trigonometri,
    // jadi dipakai kotak pembatas di sekitar titik lab: 1 derajat dianggap 110.000 m
    // (sedikit di bawah nilai sebenarnya ~110.500 m di lintang Semarang), sehingga kotak
    // ini selalu memuat lingkaran radius. Pemeriksaan jarak yang presisi (haversine)
    // dilakukan aplikasi dan hasilnya dicek lagi lewat field 'jarak'.
    function hasLabCoords(lab) {
      return (lab.keys().hasAll(['lat', 'lng']) && lab.lat is number && lab.lng is number)
        || (lab.keys().hasAll(['latitude', 'longitude']) && lab.latitude is number && lab.longitude is number);
    }

    function withinLabBox(lat, lng, lab, radius) {
      return hasLabCoords(lab)
        && math.abs(lat - lab.get('lat', lab.get('latitude', 0))) * 110000 <= radius
        && math.abs(lng - lab.get('lng', lab.get('longitude', 0))) * 110000 <= radius;
    }

    // ---------- users/{uid} ----------
    // Registrasi mandiri mendukung pilihan role 'ASLAB', 'ASPRAK', atau 'PRAKTIKAN'
    // (tetap menerima 'praktikan' untuk kompatibilitas backward).
    match /users/{uid} {
      allow read: if isOwner(uid) || isAsisten();

      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['nama', 'email', 'nim', 'role', 'createdAt'])
        && request.resource.data.keys().hasAll(['nama', 'email', 'role', 'createdAt'])
        && request.resource.data.role in ['ASLAB', 'ASPRAK', 'PRAKTIKAN', 'praktikan']
        && request.resource.data.email == request.auth.token.email.lower()
        && request.resource.data.nama is string
        && request.resource.data.nama.size() > 0
        && request.resource.data.nama.size() <= 100
        && (request.resource.data.nim == null
            || (request.resource.data.nim is string && request.resource.data.nim.size() <= 30))
        && request.resource.data.createdAt == request.time;

      // Pemilik hanya boleh mengubah nama/nim. role & email tidak bisa diubah.
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nama', 'nim'])
        && request.resource.data.nama is string
        && request.resource.data.nama.size() > 0
        && request.resource.data.nama.size() <= 100;

      allow delete: if false;
    }

    // ---------- classes, members, schedules (Sprint 1–3) ----------
    match /classes/{classId} {
      allow read: if signedIn();
      allow write: if isAsisten();

      match /members/{uid} {
        allow read: if signedIn();
        allow write: if isAsisten();
      }
    }

    match /schedules/{scheduleId} {
      allow read: if signedIn();
      allow write: if isAsisten();
    }

    // ---------- laboratories (Sprint 3 & 4 — NFR-01) ----------
    // Semua user login boleh membaca; hanya Aslab yang boleh create/update/delete.
    match /laboratories/{labId} {
      allow read: if signedIn();
      allow create, update, delete: if isAslab();
    }

    // ---------- labMembers (Sprint 4 — NFR-01) ----------
    // ID dokumen deterministik '{labId}_{userId}'. Semua user login boleh read;
    // hanya Aslab yang boleh create/update/delete.
    match /labMembers/{memberId} {
      allow read: if signedIn();

      allow create, update: if isAslab()
        && request.resource.data.keys().hasOnly(
             ['labId', 'userId', 'peran', 'aktif', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasAll(
             ['labId', 'userId', 'peran', 'aktif'])
        && request.resource.data.labId is string
        && request.resource.data.userId is string
        && memberId == request.resource.data.labId + '_' + request.resource.data.userId
        && exists(/databases/$(database)/documents/laboratories/$(request.resource.data.labId))
        && exists(/databases/$(database)/documents/users/$(request.resource.data.userId))
        && request.resource.data.peran in ['praktikan', 'asprak']
        && request.resource.data.aktif is bool;

      allow delete: if isAslab();
    }

    // ---------- sessions & attendance (Sprint 3 & 4 — NFR-01) ----------
    // Asprak hanya boleh mengelola sesi pada labId tempat ia terdaftar aktif di labMembers.
    // Aslab & Praktikan tetap dapat membaca sesuai kebutuhan dashboard dan jadwal.
    match /sessions/{sessionId} {
      allow read: if signedIn();
      allow create: if isAsprakOfLab(request.resource.data.get('labId', '')) && validStatusSesi();
      allow update: if isAsprakOfLab(resource.data.get('labId', ''))
        && isAsprakOfLab(request.resource.data.get('labId', ''))
        && validStatusSesi();
      allow delete: if isAsprakOfLab(resource.data.get('labId', ''));

      // Subkoleksi presensi Sprint 3: ID dokumen = uid praktikan.
      match /attendance/{uid} {
        allow read: if isAslab()
          || isAsprakOfLab(sessionDoc(sessionId).get('labId', ''))
          || isOwner(uid);

        allow create: if isPraktikan()
          && isOwner(uid)
          && sessionDoc(sessionId).status == 'dibuka'
          && request.resource.data.keys().hasOnly(
               ['uid', 'nama', 'waktu', 'labId', 'latitude', 'longitude', 'jarak'])
          && request.resource.data.keys().hasAll(
               ['uid', 'nama', 'waktu', 'labId', 'latitude', 'longitude', 'jarak'])
          && request.resource.data.uid == uid
          && request.resource.data.nama is string
          && request.resource.data.waktu == request.time
          && request.resource.data.labId is string
          && request.resource.data.labId == sessionDoc(sessionId).get('labId', '')
          && exists(/databases/$(database)/documents/laboratories/$(request.resource.data.labId))
          && request.resource.data.latitude is number
          && request.resource.data.longitude is number
          && request.resource.data.jarak is number
          && request.resource.data.jarak >= 0
          && request.resource.data.jarak <= labDoc(request.resource.data.labId).get('radius', 50)
          && withinLabBox(
               request.resource.data.latitude,
               request.resource.data.longitude,
               labDoc(request.resource.data.labId),
               labDoc(request.resource.data.labId).get('radius', 50));

        allow update, delete: if isAsprakOfLab(sessionDoc(sessionId).get('labId', ''));
      }
    }

    // ---------- attendances (koleksi top-level Sprint 4 — NFR-01) ----------
    match /attendances/{attendanceId} {
      allow read: if isAslab()
        || isAsprakOfLab(resource.data.get('labId', ''))
        || (isPraktikan() && isRecordOwner(resource.data));

      allow create: if isPraktikan()
        && isRecordOwner(request.resource.data)
        && request.resource.data.get('labId', '') is string
        && exists(/databases/$(database)/documents/laboratories/$(request.resource.data.get('labId', '')));

      allow update: if isAsprakOfLab(resource.data.get('labId', ''))
        && isAsprakOfLab(request.resource.data.get('labId', ''));

      allow delete: if isAsprakOfLab(resource.data.get('labId', ''));
    }

    // ---------- Token push notification (Sprint 3 — P3) ----------
    match /pushTokens/{uid} {
      allow read: if isOwner(uid) || isAsisten();

      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['uid', 'role', 'tokens', 'platform', 'updatedAt'])
        && request.resource.data.keys().hasAll(['uid', 'role', 'tokens'])
        && request.resource.data.uid == uid
        && isSameNormalizedRole(request.resource.data.role, get(userDoc(uid)).data.role)
        && request.resource.data.tokens is list
        && request.resource.data.tokens.size() <= 20;

      allow update: if (isOwner(uid)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['role', 'tokens', 'platform', 'updatedAt'])
          && isSameNormalizedRole(request.resource.data.role, get(userDoc(uid)).data.role)
          && request.resource.data.tokens is list
          && request.resource.data.tokens.size() <= 20)
        || (isAsisten()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tokens'])
          && request.resource.data.tokens.size() <= resource.data.tokens.size());

      allow delete: if false;
    }

    // ---------- Pengajuan izin (Sprint 3 & 4 — NFR-01) ----------
    // ID dokumen WAJIB '{sessionId}_{uid}'.
    // Asprak hanya dapat membaca/memutuskan izin untuk sesi pada lab tempat ia aktif.
    match /leaveRequests/{requestId} {
      allow read: if isAslab()
        || isAsprakOfLab(leaveRequestLabId(resource.data))
        || isRecordOwner(resource.data);

      allow create: if isPraktikan()
        && request.resource.data.uid == request.auth.uid
        && (!('userId' in request.resource.data) || request.resource.data.userId == request.auth.uid)
        && requestId == request.resource.data.sessionId + '_' + request.auth.uid
        && request.resource.data.keys().hasOnly(
             ['uid', 'userId', 'nama', 'sessionId', 'labId', 'alasan', 'kategoriAI', 'status', 'createdAt'])
        && request.resource.data.keys().hasAll(
             ['uid', 'sessionId', 'alasan', 'status', 'createdAt'])
        && request.resource.data.sessionId is string
        && request.resource.data.alasan is string
        && request.resource.data.alasan.size() >= 5
        && request.resource.data.alasan.size() <= 500
        && (request.resource.data.kategoriAI == null
            || (request.resource.data.kategoriAI is string
                && request.resource.data.kategoriAI.size() <= 50))
        && request.resource.data.status == 'menunggu'
        && request.resource.data.createdAt == request.time;

      allow update: if isAsprakOfLab(leaveRequestLabId(resource.data))
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'reviewedBy', 'reviewedAt', 'catatanAsisten'])
        && request.resource.data.status in ['diterima', 'ditolak']
        && request.resource.data.reviewedBy == request.auth.uid;

      allow delete: if false;
    }

    // ---------- Denda & Pembayaran (Sprint 4 — NFR-01) ----------
    // Praktikan hanya membaca milik sendiri, Aslab membaca untuk dashboard keuangan.
    // Mutasi data denda & status pembayaran hanya melalui Backend / Firebase Admin SDK.
    match /fines/{fineId} {
      allow read: if isAslab() || (isPraktikan() && isRecordOwner(resource.data));
      allow create, update, delete: if false;
    }

    match /payments/{paymentId} {
      allow read: if isAslab() || (isPraktikan() && isRecordOwner(resource.data));
      allow create, update, delete: if false;
    }
  }
}
